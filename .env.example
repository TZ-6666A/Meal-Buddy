APP_NAME=FanDazi API

# development | production。production 下缺少 API_TOKEN 会拒绝启动。
APP_ENV=development

# 数据库连接串是端口/库名的唯一来源，启动脚本和迁移都读这里。
# 本机开发集群监听 5433（见 README）。
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5433/fandazi

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 高德 Web 服务 Key（不是 JS API Key），用于服务端搜索附近店铺招牌菜。
# 在本机项目根目录 .env 中填写；留空时使用本地菜库。不要把真实 Key 提交到 Git。
AMAP_KEY=
OPENAI_REASONING_EFFORT=

# 留空表示不鉴权（仅限本地开发）。生产环境必须设置且至少 16 个字符。
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 按客户端 IP 限制推荐/对话请求次数；默认每分钟 10 次
RATE_LIMIT_PER_MINUTE=10

# 当日 token 预算，0 表示不限制；超出后推荐/对话接口返回 429
DAILY_TOKEN_BUDGET=0
# 用于估算成本，单位：每 1000 token 的价格，0 表示不计算
LLM_PRICE_PER_1K_INPUT=0
LLM_PRICE_PER_1K_OUTPUT=0
