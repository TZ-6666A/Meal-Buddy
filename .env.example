# Docker Compose: replace with a long random hex string, never commit real credentials.
POSTGRES_PASSWORD=replace_with_64_hex_characters

APP_NAME=FanDazi API

# development | production。production 下缺少 API_TOKEN 会拒绝启动。
APP_ENV=development

# 数据库连接串是端口/库名的唯一来源，启动脚本和迁移都读这里。
# 本机开发集群监听 5433（见 README）。
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5433/fandazi

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 高德 Web 服务 Key（不是 JS API Key），用于服务端搜索附近店铺招牌菜。
# 在本机项目根目录 .env 中填写；留空时使用本地菜库。不要把真实 Key 提交到 Git。
AMAP_KEY=
OPENAI_REASONING_EFFORT=

# 留空表示不鉴权（仅限本地开发）。生产环境必须设置且至少 16 个字符。
# 配置后可作为脚本通道：携带 X-API-Token 的请求会映射到管理员账号。
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 登录系统 ----------
# 首次启动引导的管理员账号（生产环境 ADMIN_PASSWORD 必填，至少 8 位）。
# 历史数据会归入该账号名下。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 配置后绑定到管理员账号，可以用邮箱代替用户名登录。
ADMIN_EMAIL=
# 邮箱验证码注册开启后，邀请码注册自动停用（邮箱验证码即注册门槛）。
INVITE_CODE=
# 登录会话有效期（天），Cookie 为 HttpOnly，默认 30 天
SESSION_TTL_DAYS=30
# 开发/测试免登录旁路（生产环境固定关闭）；本地想体验真实登录流程时设为 false
DEV_AUTO_LOGIN=true

# ---------- 邮箱验证码注册 ----------
# 配置 SMTP_USER + SMTP_PASSWORD 后启用：注册必须凭邮箱验证码，不再需要邀请码。
# QQ 邮箱：网页版「设置 → 账号 → POP3/IMAP/SMTP 服务」开启并生成授权码，
# 授权码填在 SMTP_PASSWORD（不是 QQ 密码）。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# ssl | starttls | none
SMTP_TLS=ssl
SMTP_USER=
SMTP_PASSWORD=
# 发件人显示名
EMAIL_FROM_NAME=饭搭子
# 只允许这些邮箱域名注册（逗号分隔，留空=不限），例如：qq.com
EMAIL_ALLOWED_DOMAINS=
# 验证码有效期（分钟）、重发冷却（秒）、每邮箱每日上限
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_PER_DAY=10

# 按客户端 IP 限制推荐/对话请求次数；默认每分钟 10 次
RATE_LIMIT_PER_MINUTE=10

# 当日 token 预算，0 表示不限制；超出后推荐/对话接口返回 429
DAILY_TOKEN_BUDGET=0
# 用于估算成本，单位：每 1000 token 的价格，0 表示不计算
LLM_PRICE_PER_1K_INPUT=0
LLM_PRICE_PER_1K_OUTPUT=0
