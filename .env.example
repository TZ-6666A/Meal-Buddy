APP_NAME=FanDazi API
DATABASE_URL=postgresql+psycopg://postgres:change_me@127.0.0.1:5432/fandazi
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 按客户端 IP 限制推荐/对话请求次数；默认每分钟 10 次
RATE_LIMIT_PER_MINUTE=10

# 当日 token 预算，0 表示不限制；超出后推荐/对话接口返回 429
DAILY_TOKEN_BUDGET=0
# 用于估算成本，单位：每 1000 token 的价格，0 表示不计算
LLM_PRICE_PER_1K_INPUT=0
LLM_PRICE_PER_1K_OUTPUT=0
